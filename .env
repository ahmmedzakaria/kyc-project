# .env.example
POSTGRES_DB=kyc_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
DB_HOST=localhost
DB_PORT=5432

# Dedicated public catalog database (local PostgreSQL is exposed on port 5433).
CATALOG_DB_JDBC_URL=jdbc:postgresql://host.docker.internal:5433/catalog_db
CATALOG_DB_USERNAME=postgres
DB_CATALOG_PASSWORD=123456
CATALOG_CLIENT_ALLOWED_ORIGINS=http://localhost:4400,http://catalog.localhost:4400,http://abd.localhost:4400

BACKEND_PORT=9100
FRONTEND_PORT=4200

JWT_SECRET=change_this_secret
